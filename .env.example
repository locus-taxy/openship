DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/your_db_name

# API key encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=your-generated-fernet-key-here

# Run alembic upgrade head when the API starts (true/false; default true if unset)
RUN_MIGRATIONS_ON_STARTUP=true

JWT_SECRET_KEY=your_secret_key_min_32_chars_here_generate_with_secrets
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2
JWT_REFRESH_TOKEN_EXPIRE_HOURS=7

# ── Atlassian (Confluence + Jira) — the knowledge platform ──────────────────────
# One OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/ grants
# BOTH Confluence and Jira. Add the Jira API to the app and grant read scopes, else
# reconnect returns a "scopes not added" error.
ATLASSIAN_CLIENT_ID=your_atlassian_oauth_client_id
ATLASSIAN_CLIENT_SECRET=your_atlassian_oauth_client_secret
ATLASSIAN_REDIRECT_URI=https://your-host/py/confluence/callback
# Optional — override the default read scopes (Confluence + Jira + offline_access +
# read:me, used to verify the connecting Atlassian account matches the Openship login):
# ATLASSIAN_OAUTH_SCOPES=offline_access read:confluence-space.summary read:confluence-content.summary read:confluence-content.all search:confluence read:jira-work read:jira-user read:me
# Where the browser lands after a successful connect:
CONFLUENCE_POST_CONNECT_REDIRECT=/onboarding?connected=1

# ── Embeddings (local, no API key) ──────────────────────────────────────────────
# Local fastembed model; 384-dim must match the document_chunks vector column.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Webhooks (optional — freshness) ─────────────────────────────────────────────
# Set a secret to ENABLE that source's webhook endpoint (POST /py/webhooks/{source}).
# Register the URL in Atlassian to actually receive events (see KNOWLEDGE_PLATFORM_DESIGN.md).
# Without these, re-ingest / reconcile keeps the knowledge base fresh.
CONFLUENCE_WEBHOOK_SECRET=your_confluence_webhook_shared_secret
JIRA_WEBHOOK_SECRET=your_jira_webhook_shared_secret
