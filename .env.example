DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/your_db_name

# API key encryption — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=your-generated-fernet-key-here

# Run alembic upgrade head when the API starts (true/false; default true if unset)
RUN_MIGRATIONS_ON_STARTUP=true

JWT_SECRET_KEY=your_secret_key_min_32_chars_here_generate_with_secrets
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2
JWT_REFRESH_TOKEN_EXPIRE_HOURS=7

# Code Sandbox — set to true to run user code inside Docker containers (recommended for production).
# Requires Docker installed and `make sandbox-build` to have been run once.
# Set to false (default) to run code via direct subprocess (no Docker needed, easier for local dev).
SANDBOX_USE_DOCKER=false
SANDBOX_DOCKER_IMAGE=openship-sandbox

# ── Docker Compose deployment ─────────────────────────────────────────────────
# Used by docker-compose.yml — not needed for local development (make setup).
# Generate JWT_SECRET_KEY and LLM_ENCRYPTION_KEY with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_PASSWORD=changeme
OPENSHIP_JS_SANDBOX_PATH=/opt/openship_js_sandbox
