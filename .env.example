GEMINI_API_KEY=your_gemini_api_key_here
# If you see repeated HTTP 503, Google’s model may be overloaded — try another model ID in the path, e.g. gemini-2.0-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-lite:generateContent
DATABASE_URL=postgresql+psycopg2://your_user:your_password@localhost:5432/your_db_name

# Run alembic upgrade head when the API starts (true/false; default true if unset)
RUN_MIGRATIONS_ON_STARTUP=true

JWT_SECRET_KEY=your_secret_key_min_32_chars_here_generate_with_secrets
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2
JWT_REFRESH_TOKEN_EXPIRE_HOURS=7
# Outbound email (company-managed SMTP relay; no third-party API)
SMTP_HOST=smtp.your-company.internal
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@your-company.com
SMTP_FROM_NAME=Openship
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
